{
  "name": "infinite-pixel-functions",
  "description": "Firebase Cloud Functions for Infinite Pixel website leads",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions:emailContactRequest",
    "logs": "firebase functions:log --only emailContactRequest"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.0",
    "resend": "^6.17.2"
  }
}
